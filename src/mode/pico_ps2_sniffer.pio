.program inhibited_signal

.wrap_target
restart:
    mov isr, null
wait_for_inhibited:
    set x, 30
check_inhibited:
    jmp pin wait_for_inhibited
    jmp pin wait_for_inhibited
    jmp x-- check_inhibited
    irq nowait 0
    wait 1 pin 1
    in pins, 1
    mov y, isr
    jmp !y, restart
    irq nowait 1
.wrap

.program device_to_host

.wrap_target
wait_for_start_signal:
    jmp pin wait_for_start_signal
    mov isr, null
skip_start_bit:
    wait 0 pin 1
    wait 1 pin 1
proceed_to_capture:
    set x, 7
capture_8_bits_loop:
    wait 0 pin 1 [1]
    in pins, 1
    wait 1 pin 1 [1]
    jmp x-- capture_8_bits_loop
skip_parity_and_stop_bits:
    wait 0 pin 1 [1]
    jmp pin wait_for_start_signal [1]
    push noblock
    wait 1 pin 1
    wait 0 pin 1 [1]
    wait 1 pin 1
.wrap

.program host_to_device

.wrap_target
    mov isr, null
wait_for_inhibition:
    set x, 5
check_inhibition_loop:
    jmp pin wait_for_inhibition
    jmp x--, check_inhibition_loop
skip_start_bit:
    wait 1 pin 1
    wait 0 pin 1
proceed_to_capture:
    set x, 7
capture_8_bits_loop:
    wait 1 pin 1 [1]
    in pins, 1
    wait 0 pin 1 [1]
    jmp x-- capture_8_bits_loop
skip_parity_and_stop_bits:
    wait 1 pin 1 [1]
    push noblock
    wait 0 pin 1
    wait 1 pin 1 [1]
skip_ack_bit:
    wait 0 pin 1 [1]
.wrap

.program idle_signal

.wrap_target
wait_for_idle:
    set x, 30
check_idle_loop:
    mov osr, !pins
    out y, 2
    jmp !y, next_idle_check
not_idle_detected:
    jmp wait_for_idle
next_idle_check:
    jmp x--, check_idle_loop
idle_detected:
    irq nowait 0
.wrap
